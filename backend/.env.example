# KYOOL Media Platform Backend - Environment Configuration Example
# Copy this file to .env and update the values for your environment

# Environment Configuration
ENVIRONMENT=development
SERVER_VERSION=1.10.0

# Database Configuration
# For development (SQLite)
DATABASE_URI=sqlite:///./kyool_media.db

# For production (PostgreSQL)
# DATABASE_URI=postgresql://user:password@host:5432/kyool_media
# POSTGRES_SERVER=localhost
# POSTGRES_USER=kyool_user
# POSTGRES_PASSWORD=your_postgres_password
# POSTGRES_DB=kyool_media

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Authentication & Security
SECRET_KEY=your-very-secure-secret-key-change-in-production-use-256-bit-key
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256

# File Upload Storage Configuration
UPLOAD_LOCAL_STORAGE_PATH=./uploads
UPLOAD_LOCAL_BASE_URL=http://localhost:8000/files

# Backend Selection for Media Types
UPLOAD_VIDEO_BACKEND=local
UPLOAD_WEBCOMIC_BACKEND=local

# AWS S3 Configuration (Optional)
# UPLOAD_S3_BUCKET_NAME=your-s3-bucket-name
# UPLOAD_S3_REGION=us-east-1
# UPLOAD_S3_ACCESS_KEY=your-aws-access-key
# UPLOAD_S3_SECRET_KEY=your-aws-secret-key
# UPLOAD_S3_ENDPOINT_URL=https://s3.amazonaws.com
# UPLOAD_S3_ACL=private

# MUX Video Processing Configuration
# Get these from your Mux dashboard: https://dashboard.mux.com/

# Mux API Credentials (for video upload and processing)
UPLOAD_MUX_TOKEN_ID=your_mux_token_id_here
UPLOAD_MUX_TOKEN_SECRET=your_mux_token_secret_here
UPLOAD_MUX_WEBHOOK_URL=https://yourdomain.com/api/v1/mux/webhook
UPLOAD_MUX_ENCODING_TIER=baseline

# Mux Signing Keys (for secure video playback with JWT tokens)
# Get these from Mux Dashboard > Settings > Signing Keys
MUX_SIGNING_KEY_ID=your_mux_signing_key_id_here
MUX_PRIVATE_KEY=your_mux_private_key_here_base64_or_pem_format

# Example MUX_PRIVATE_KEY formats:
# Base64 encoded:
# MUX_PRIVATE_KEY=LS0tLS1CRUdJTiBSU0EgUFJJVkFURSBLRVktLS0tLQ==

# PEM format (multiline):
# MUX_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
# MIIEpAIBAAKCAQEA7S...your_key_content...
# -----END RSA PRIVATE KEY-----"

# Notes:
# - Set UPLOAD_VIDEO_BACKEND=mux to use Mux for video processing
# - MUX_SIGNING_KEY_ID and MUX_PRIVATE_KEY are required for secure video playback
# - UPLOAD_MUX_WEBHOOK_URL should point to your server's webhook endpoint
# - Keep MUX_PRIVATE_KEY secure - never commit to version control