{
  "name": "media-analyzer",
  "version": "1.0.0",
  "description": "Media file analyzer and associator with separate folder support",
  "main": "main.js",
  "type": "commonjs",
  "bin": {
    "media-analyzer": "./src/cli.js"
  },
  "scripts": {
    "start": "node src/cli.js",
    "gui": "electron --no-sandbox main.js",
    "test": "node src/cli.js --help",
    "dev": "node src/cli.js",
    "build": "electron-builder",
    "build-win": "electron-builder --win",
    "dist": "npm run build",
    "pack": "electron-builder --dir"
  },
  "dependencies": {
    "commander": "^11.0.0",
    "fluent-ffmpeg": "^2.1.2",
    "glob": "^8.1.0",
    "glob-promise": "^6.0.0",
    "string-similarity": "^4.0.4",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "electron": "^37.3.1",
    "electron-builder": "^25.1.8",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0"
  },
  "keywords": [
    "media",
    "video",
    "subtitle",
    "image",
    "analyzer",
    "ffmpeg"
  ],
  "author": "Media Analyzer Tool",
  "license": "MIT",
  "build": {
    "appId": "com.mediaanalyzer.app",
    "productName": "Media Analyzer",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "src/**/*",
      "node_modules/**/*",
      "!node_modules/ffmpeg-static/bin/darwin/**",
      "!node_modules/ffmpeg-static/bin/linux/**",
      "!node_modules/ffprobe-static/bin/darwin/**",
      "!node_modules/ffprobe-static/bin/linux/**"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
