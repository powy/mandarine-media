{
  "auth": {
    "mux_token_id": "mock-token-id",
    "mux_token_secret": "mock-token-secret"
  },
  "s3": {
    "access_key_id": "mock-access-key",
    "secret_access_key": "mock-secret-key",
    "region": "us-east-1",
    "bucket_name": "mock-test-bucket",
    "presigned_url_expiry": 3600
  },
  "mux_asset_id": "mock-asset-id-12345",
  "subtitles": [
    {
      "file_path": "test-data/test_english.srt",
      "language_code": "en",
      "name": "English",
      "text_type": "subtitles",
      "closed_captions": false,
      "passthrough": "test-en"
    },
    {
      "file_path": "test-data/test_spanish.vtt",
      "language_code": "es",
      "name": "Español",
      "text_type": "subtitles",
      "closed_captions": false,
      "passthrough": "test-es"
    },
    {
      "file_path": "test-data/test_french.srt",
      "language_code": "fr",
      "name": "Français",
      "text_type": "subtitles",
      "closed_captions": false,
      "passthrough": "test-fr"
    }
  ],
  "logging": {
    "enabled": true,
    "level": "debug",
    "console": true,
    "format": "simple"
  },
  "options": {
    "cleanup_delay_minutes": 5,
    "max_retry_attempts": 2,
    "validate_before_upload": true,
    "monitoring_timeout": 30000
  }
}