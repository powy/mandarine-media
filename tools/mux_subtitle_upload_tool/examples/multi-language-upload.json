{
  "auth": {
    "mux_token_id": "YOUR_MUX_TOKEN_ID",
    "mux_token_secret": "YOUR_MUX_TOKEN_SECRET"
  },
  "s3": {
    "access_key_id": "YOUR_AWS_ACCESS_KEY_ID",
    "secret_access_key": "YOUR_AWS_SECRET_ACCESS_KEY",
    "region": "us-east-1",
    "bucket_name": "your-mux-subtitles-bucket",
    "presigned_url_expiry": 3600
  },
  "mux_asset_id": "your-existing-mux-asset-id",
  "subtitles": [
    {
      "file_path": "/path/to/subtitles/english.srt",
      "language_code": "en",
      "name": "English",
      "text_type": "subtitles",
      "closed_captions": false,
      "passthrough": "en-srt"
    },
    {
      "file_path": "/path/to/subtitles/spanish.vtt",
      "language_code": "es",
      "name": "Español",
      "text_type": "subtitles",
      "closed_captions": false,
      "passthrough": "es-vtt"
    },
    {
      "file_path": "/path/to/subtitles/french.srt",
      "language_code": "fr",
      "name": "Français",
      "text_type": "subtitles",
      "closed_captions": false,
      "passthrough": "fr-srt"
    },
    {
      "file_path": "/path/to/subtitles/korean.srt",
      "language_code": "ko",
      "name": "한국어",
      "text_type": "subtitles",
      "closed_captions": false,
      "passthrough": "ko-srt"
    }
  ],
  "logging": {
    "enabled": true,
    "level": "debug",
    "console": true,
    "format": "simple",
    "file": "./logs/multi-language-upload.log"
  },
  "options": {
    "cleanup_delay_minutes": 180,
    "max_retry_attempts": 5,
    "retry_delay": 3000,
    "validate_before_upload": true,
    "monitoring_timeout": 90000,
    "monitoring_interval": 3000
  }
}