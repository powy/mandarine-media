{
  "auth": {
    "mux_token_id": "YOUR_MUX_TOKEN_ID",
    "mux_token_secret": "YOUR_MUX_TOKEN_SECRET"
  },
  "video": {
    "filepath": "/path/to/your/video.mp4",
    "title": "Full Featured Video Upload",
    "description": "Comprehensive example with all features enabled"
  },
  "settings": {
    "playback_policy": ["signed"],
    "video_quality": "plus",
    "max_resolution_tier": "2160p",
    "normalize_audio": true,
    "master_access": "temporary",
    "mp4_support": "standard",
    "passthrough": "full-featured-upload-001",
    "cors_origin": "https://yourdomain.com"
  },
  "metadata": {
    "title": "Amazing Video Content",
    "description": "This is a comprehensive video upload example",
    "external_id": "vid-12345",
    "creator_id": "creator-789",
    "category": "education",
    "tags": ["tutorial", "demo", "mux"],
    "custom_field_1": "value1",
    "custom_field_2": "value2",
    "content_rating": "G",
    "language": "en-US",
    "duration_estimate": 300
  },
  "subtitles": [
    {
      "url": "https://example.com/subtitles/english.srt",
      "language_code": "en-US",
      "name": "English",
      "text_type": "subtitles",
      "closed_captions": false,
      "passthrough": "en-subtitle-1"
    },
    {
      "url": "https://example.com/subtitles/spanish.srt",
      "language_code": "es-ES",
      "name": "Spanish",
      "text_type": "subtitles",
      "closed_captions": false,
      "passthrough": "es-subtitle-1"
    },
    {
      "url": "https://example.com/subtitles/french.srt",
      "language_code": "fr-FR",
      "name": "French",
      "text_type": "subtitles",
      "closed_captions": false,
      "passthrough": "fr-subtitle-1"
    },
    {
      "url": "https://example.com/subtitles/english-cc.srt",
      "language_code": "en-US",
      "name": "English (Closed Captions)",
      "text_type": "subtitles",
      "closed_captions": true,
      "passthrough": "en-cc-1"
    }
  ],
  "static_renditions": {
    "files": [
      {
        "name": "low_quality",
        "ext": "mp4",
        "resolution_tier": "720p",
        "passthrough": "static-720p"
      },
      {
        "name": "high_quality",
        "ext": "mp4",
        "resolution_tier": "1080p",
        "passthrough": "static-1080p"
      },
      {
        "name": "ultra_high_quality",
        "ext": "mp4",
        "resolution_tier": "2160p",
        "passthrough": "static-2160p"
      }
    ]
  },
  "watermark": {
    "url": "https://example.com/assets/watermark.png",
    "overlay_settings": {
      "vertical_align": "bottom",
      "vertical_margin": "5%",
      "horizontal_align": "right",
      "horizontal_margin": "5%",
      "width": "15%",
      "opacity": "75%"
    }
  },
  "database": {
    "type": "postgresql",
    "connection": {
      "host": "localhost",
      "port": 5432,
      "database": "video_platform",
      "user": "video_user",
      "password": "secure_password"
    },
    "table": "mux_assets",
    "save_playback_ids": true,
    "save_tracks": true,
    "save_metadata": true
  },
  "logging": {
    "enabled": true,
    "level": "debug",
    "file": "./logs/full-featured-upload.log",
    "console": true,
    "format": "json"
  },
  "webhook": {
    "enabled": true,
    "url": "https://yourdomain.com/webhooks/mux",
    "events": [
      "video.asset.ready",
      "video.asset.errored",
      "video.asset.created",
      "video.asset.updated",
      "video.upload.asset_created",
      "video.upload.errored"
    ]
  },
  "options": {
    "timeout": 7200000,
    "retry_attempts": 5,
    "retry_delay": 8000,
    "chunk_size": 52428800,
    "concurrent_uploads": 1
  }
}