/**
 * Batch Upload Worker
 * Worker process for batch folder upload tasks (corresponds to execute_upload_batch in GUI)
 */

import BaseWorker from './baseWorker.js';
import { execFilePromise } from '../utils/processUtils.js';

class BatchUploadWorker extends BaseWorker {
  constructor() {
    super();
    this.logInfo('Batch Upload Worker initialized');
  }

  async execute(taskData) {
    this.validateTaskData(taskData, ['batchFolderPath']);

    const { batchFolderPath, config, options = {} } = taskData;

    this.logInfo('Starting batch upload', { batchFolderPath, options });
    this.updateProgress(5, 'Initializing batch upload...');

    // Validate batch folder path
    if (!(await this.isDirectory(batchFolderPath))) {
      throw new Error(`Batch folder path does not exist or is not a directory: ${batchFolderPath}`);
    }

    this.updateProgress(10, 'Batch folder validated, starting upload...');

    try {
      // Use the one-media-complete-upload wrapper script with batch flag
      const scriptPath = this.getToolPath('subtools/one-media-complete-upload/wrapper.js');

      if (!(await this.fileExists(scriptPath))) {
        throw new Error(`Upload script not found: ${scriptPath}`);
      }

      const args = [
        '--batch-folder', batchFolderPath
      ];

      // Add config if provided
      if (config && config.configPath) {
        args.push('--config', config.configPath);
      }

      // Add additional options
      if (options.skipValidation) {
        args.push('--skip-validation');
      }

      if (options.continueOnError !== false) {
        args.push('--continue-on-error');
      }

      this.updateProgress(20, 'Starting batch upload process...');
      this.logInfo('Executing batch upload command', { scriptPath, args });

      // Execute the batch upload script
      const result = await execFilePromise('node', [scriptPath, ...args], {
        timeout: options.timeout || 1800000, // 30 minutes default for batch
        maxBuffer: 1024 * 1024 * 10, // 10MB buffer
        env: { ...process.env }
      });

      this.updateProgress(80, 'Batch upload process completed, processing results...');

      // Parse the output
      let uploadResult;
      try {
        // Try to parse JSON from stdout
        const jsonMatch = result.stdout.match(/\{[\s\S]*\}/);
        if (jsonMatch) {
          uploadResult = JSON.parse(jsonMatch[0]);
        } else {
          // Fallback to parsing batch-specific patterns
          uploadResult = this.parseBatchOutput(result.stdout, result.stderr);
        }
      } catch (parseError) {
        this.logWarn('Failed to parse batch upload result as JSON', { parseError: parseError.message });
        uploadResult = this.parseBatchOutput(result.stdout, result.stderr);
      }

      if (!uploadResult.success && result.exitCode !== 0) {
        throw new Error(`Batch upload failed with exit code ${result.exitCode}: ${result.stderr || result.stdout}`);
      }

      this.updateProgress(100, 'Batch upload completed');

      return {
        success: true,
        batchFolderPath,
        uploadResult,
        metadata: {
          batchFolderPath,
          exitCode: result.exitCode,
          uploadTime: Date.now() - this.startTime,
          processedCount: uploadResult.processedCount || 0,
          totalSubfolders: uploadResult.totalSubfolders || 0,
          failedFolders: uploadResult.failedFolders || [],
          successRate: uploadResult.successRate || 0
        }
      };

    } catch (error) {
      this.logError('Batch upload failed', {
        batchFolderPath,
        error: error.message,
        stack: error.stack
      });

      throw new Error(`Batch upload failed: ${error.message}`);
    }
  }

  parseBatchOutput(stdout, stderr) {
    const result = {
      success: false,
      processedCount: 0,
      totalSubfolders: 0,
      failedFolders: [],
      successRate: 0,
      message: stdout,
      error: stderr
    };

    // Parse batch completion patterns
    const completionMatch = stdout.match(/(\d+)\/(\d+)\s+successful/);
    if (completionMatch) {
      result.processedCount = parseInt(completionMatch[1]);
      result.totalSubfolders = parseInt(completionMatch[2]);
      result.successRate = result.totalSubfolders > 0 ? (result.processedCount / result.totalSubfolders) * 100 : 0;
      result.success = true;
    }

    // Parse failed folder information
    const failedMatch = stdout.match(/Failed uploads:\s*(.+)/);
    if (failedMatch) {
      result.failedFolders = failedMatch[1].split(',').map(f => f.trim()).filter(f => f.length > 0);
    }

    return result;
  }

  async cleanup() {
    this.logInfo('Cleaning up batch upload worker');
    // Add any specific cleanup logic here
  }
}

// Start the worker if this file is executed directly
if (import.meta.url === `file://${process.argv[1]}`) {
  new BatchUploadWorker();
}

export default BatchUploadWorker;