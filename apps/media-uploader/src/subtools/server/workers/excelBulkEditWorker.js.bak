/**
 * Excel Bulk Edit Worker
 */

import BaseWorker from './baseWorker.js';
import { execFilePromise } from '../utils/processUtils.js';

class ExcelBulkEditWorker extends BaseWorker {
  constructor() {
    super();
    this.logInfo('Excel Bulk Edit Worker initialized');
  }

  async execute(taskData) {
    this.validateTaskData(taskData, ['folderPath', 'fieldName', 'fieldValue']);

    const { folderPath, fieldName, fieldValue, config, options = {} } = taskData;

    this.logInfo('Starting Excel bulk edit', { folderPath, fieldName, options });
    this.updateProgress(5, 'Initializing Excel bulk edit...');

    if (!(await this.isDirectory(folderPath))) {
      throw new Error(`Folder path does not exist or is not a directory: ${folderPath}`);
    }

    this.updateProgress(10, 'Folder validated, starting bulk edit...');

    try {
      const scriptPath = this.getToolPath('subtools/excel-batch-editor/wrapper.js');

      if (!(await this.fileExists(scriptPath))) {
        throw new Error(`Excel editor script not found: ${scriptPath}`);
      }

      const args = [
        '--folder', folderPath,
        '--field', fieldName,
        '--value', fieldValue,
        '--pattern', options.pattern || '0_desc',
        '--verbose'
      ];

      if (config && config.configPath) {
        args.push('--config', config.configPath);
      }

      if (options.dryRun) {
        args.push('--dry-run');
      }

      this.updateProgress(20, `Starting bulk edit: ${fieldName} = ${fieldValue}...`);
      this.logInfo('Executing bulk edit command', { scriptPath, args });

      const result = await execFilePromise('node', [scriptPath, ...args], {
        timeout: options.timeout || 300000, // 5 minutes default
        maxBuffer: 1024 * 1024 * 5, // 5MB buffer
        env: { ...process.env }
      });

      this.updateProgress(80, 'Bulk edit process completed...');

      if (result.exitCode !== 0) {
        throw new Error(`Excel bulk edit failed with exit code ${result.exitCode}: ${result.stderr || result.stdout}`);
      }

      this.updateProgress(100, 'Excel bulk edit completed successfully');

      return {
        success: true,
        folderPath,
        fieldName,
        fieldValue,
        editResult: {
          success: true,
          message: result.stdout,
          dryRun: options.dryRun || false,
          pattern: options.pattern || '0_desc'
        },
        metadata: {
          folderPath,
          fieldName,
          fieldValue,
          dryRun: options.dryRun || false,
          exitCode: result.exitCode,
          editTime: Date.now() - this.startTime
        }
      };

    } catch (error) {
      this.logError('Excel bulk edit failed', {
        folderPath,
        fieldName,
        fieldValue,
        error: error.message,
        stack: error.stack
      });

      throw new Error(`Excel bulk edit failed: ${error.message}`);
    }
  }

  async cleanup() {
    this.logInfo('Cleaning up Excel bulk edit worker');
  }
}

if (import.meta.url === `file://${process.argv[1]}`) {
  new ExcelBulkEditWorker();
}

export default ExcelBulkEditWorker;