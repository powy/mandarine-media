/**
 * Subtitle Specific Upload Worker
 * Handles individual subtitle file uploads with language detection and Excel integration
 */

import BaseWorker from './baseWorker.js';
import { execFilePromise } from '../utils/processUtils.js';
import { detectLanguageFromFilename, getLanguageDisplayName, isValidBCP47 } from '../../../shared/utils/languageUtils.js';
import { ExcelService } from '../../../one-media-complete-upload/services/excelService.js';
import path from 'path';
import fs from 'fs-extra';

class SubtitleSpecificWorker extends BaseWorker {
  constructor() {
    super();
    this.logInfo('Subtitle Specific Upload Worker initialized');
  }

  async execute(taskData) {
    this.validateTaskData(taskData, ['subtitlePath']);

    const {
      subtitlePath,
      mediaDescriptionId,
      folderPath,
      config,
      options = {}
    } = taskData;

    this.logInfo('Starting subtitle-specific upload', {
      subtitlePath,
      mediaDescriptionId,
      folderPath,
      options
    });

    this.updateProgress(5, 'Initializing subtitle-specific upload...');

    // Step 1: Validate subtitle file exists
    if (!(await this.isFile(subtitlePath))) {
      throw new Error(`Subtitle file does not exist: ${subtitlePath}`);
    }

    this.updateProgress(10, 'Subtitle file validated');

    // Step 2: Detect language from filename if auto-detection is enabled
    let detectedLanguage = null;
    if (options.autoDetectLanguage !== false) {
      this.updateProgress(15, 'Detecting language from filename...');

      const fileName = path.basename(subtitlePath);
      detectedLanguage = detectLanguageFromFilename(fileName);

      if (detectedLanguage) {
        this.logInfo(`Language detected from filename: ${detectedLanguage} (${getLanguageDisplayName(detectedLanguage)})`);
      } else {
        this.logInfo(`Could not detect language from filename: ${fileName}`);
      }
    }

    // Step 3: Determine final language to use
    const finalLanguage = options.languageOverride ||
                         options.detectedLanguage ||
                         detectedLanguage;

    if (!finalLanguage) {
      throw new Error('No language detected or specified. Please provide a language override or ensure the filename contains language indicators (e.g., _en, _fr, _ko).');
    }

    // Validate language code
    if (!isValidBCP47(finalLanguage)) {
      this.logWarn(`Language code "${finalLanguage}" may not be valid BCP 47 format`);
    }

    this.updateProgress(25, `Using language: ${finalLanguage} (${getLanguageDisplayName(finalLanguage)})`);

    // Step 4: Get media description ID from Excel if auto-lookup is enabled
    let finalMediaDescriptionId = mediaDescriptionId;

    if (!finalMediaDescriptionId && options.autoLookupMediaId !== false && folderPath) {
      this.updateProgress(30, 'Looking up media description ID from Excel...');

      try {
        finalMediaDescriptionId = await this.lookupMediaDescriptionId(folderPath);
        if (finalMediaDescriptionId) {
          this.logInfo(`Found media description ID from Excel: ${finalMediaDescriptionId}`);
        } else {
          this.logWarn('No media description ID found in Excel Description sheet');
        }
      } catch (error) {
        this.logWarn(`Failed to lookup media description ID: ${error.message}`);
      }
    }

    if (!finalMediaDescriptionId) {
      throw new Error('Media description ID is required but not found. Please specify mediaDescriptionId or provide a folder path with a valid Excel file.');
    }

    this.updateProgress(45, 'Media description ID obtained, preparing subtitle upload...');

    // Step 5: Call existing mux-subtitle-upload tool
    try {
      const scriptPath = this.getToolPath('subtools/mux-subtitle-upload/wrapper.js');

      if (!(await this.fileExists(scriptPath))) {
        throw new Error(`Subtitle upload script not found: ${scriptPath}`);
      }

      // Prepare arguments for the subtitle upload tool
      const args = [
        '--subtitle-path', subtitlePath,
        '--video-id', finalMediaDescriptionId,
        '--language', finalLanguage
      ];

      if (config && config.configPath) {
        args.push('--config', config.configPath);
      }

      this.updateProgress(50, 'Starting subtitle upload process...');
      this.logInfo('Executing subtitle upload command', { scriptPath, args });

      const result = await execFilePromise('node', [scriptPath, ...args], {
        timeout: options.timeout || 300000, // 5 minutes default
        maxBuffer: 1024 * 1024 * 5, // 5MB buffer
        env: { ...process.env }
      });

      this.updateProgress(85, 'Subtitle upload completed, processing results...');

      // Parse result
      let uploadResult;
      try {
        const jsonMatch = result.stdout.match(/\{[\s\S]*\}/);
        if (jsonMatch) {
          uploadResult = JSON.parse(jsonMatch[0]);
        } else {
          uploadResult = {
            success: result.exitCode === 0,
            message: result.stdout,
            error: result.stderr
          };
        }
      } catch (parseError) {
        uploadResult = {
          success: result.exitCode === 0,
          message: result.stdout,
          error: result.stderr,
          parseError: parseError.message
        };
      }

      if (!uploadResult.success && result.exitCode !== 0) {
        throw new Error(`Subtitle upload failed with exit code ${result.exitCode}: ${result.stderr || result.stdout}`);
      }

      this.updateProgress(100, 'Subtitle-specific upload completed successfully');

      return {
        success: true,
        subtitlePath,
        mediaDescriptionId: finalMediaDescriptionId,
        language: finalLanguage,
        detectedLanguage,
        languageOverride: options.languageOverride,
        uploadResult,
        metadata: {
          subtitlePath,
          mediaDescriptionId: finalMediaDescriptionId,
          language: finalLanguage,
          detectedLanguage,
          finalLanguageSource: options.languageOverride ? 'override' :
                              options.detectedLanguage ? 'frontend' :
                              detectedLanguage ? 'filename' : 'unknown',
          mediaIdSource: mediaDescriptionId ? 'provided' : 'excel_lookup',
          exitCode: result.exitCode,
          uploadTime: Date.now() - this.startTime
        }
      };

    } catch (error) {
      this.logError('Subtitle-specific upload failed', {
        subtitlePath,
        mediaDescriptionId: finalMediaDescriptionId,
        language: finalLanguage,
        error: error.message,
        stack: error.stack
      });

      throw new Error(`Subtitle-specific upload failed: ${error.message}`);
    }
  }

  /**
   * Lookup media description ID from Excel Description sheet
   * @param {string} folderPath - Path to folder containing Excel file
   * @returns {string|null} - Media description ID or null if not found
   */
  async lookupMediaDescriptionId(folderPath) {
    try {
      // Create ExcelService instance
      const excelService = new ExcelService(folderPath, this);

      // Find existing Excel file
      const excelPath = await excelService.findExistingExcelFile();
      if (!excelPath) {
        this.logWarn('No Excel file found in folder for media ID lookup');
        return null;
      }

      // Read Excel file
      const excelData = await excelService.readExcelFile(excelPath);

      // Look for 'id' field in description data
      if (excelData.description && excelData.description.id) {
        return excelData.description.id;
      }

      // Alternative: look for media_description_id or similar fields
      const possibleIdFields = ['id', 'media_description_id', 'media_id', 'description_id'];
      for (const field of possibleIdFields) {
        if (excelData.description && excelData.description[field]) {
          this.logInfo(`Found media ID in field '${field}': ${excelData.description[field]}`);
          return excelData.description[field];
        }
      }

      this.logWarn('No media description ID found in Excel Description sheet');
      return null;

    } catch (error) {
      this.logError('Error looking up media description ID from Excel', {
        folderPath,
        error: error.message
      });
      throw error;
    }
  }

  async cleanup() {
    this.logInfo('Cleaning up subtitle-specific upload worker');
  }
}

if (import.meta.url === `file://${process.argv[1]}`) {
  new SubtitleSpecificWorker();
}

export default SubtitleSpecificWorker;