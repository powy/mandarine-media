{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "com.kyool.media-uploader",
  "productName": "Kyool Media Uploader",
  "version": "1.0.0",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "frontendDist": "../src/frontend"
  },
  "app": {
    "windows": [
      {
        "title": "Kyool Media Uploader",
        "width": 1000,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ],
    "resources": [
      "../src/subtools/**/*",
      "../package.json",
      "../node_modules/**/*"
    ]
  },
  "plugins": {}
}