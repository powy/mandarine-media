{
  "name": "media-uploader",
  "version": "1.0.0",
  "description": "Unified media upload tool consolidating media-analyzer, mux-upload, mux-subtitle-upload, and picture-upload tools",
  "main": "src/index.js",
  "type": "module",
  "bin": {
    "media-uploader": "./src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "node --experimental-vm-modules ../../node_modules/.bin/jest --config=jest.config.js",
    "test:unit": "cross-env NODE_ENV=test NODE_OPTIONS=\"--experimental-vm-modules\" jest tests/unit",
    "test:integration": "cross-env NODE_ENV=test NODE_OPTIONS=\"--experimental-vm-modules\" jest tests/integration",
    "test:orchestration": "node --experimental-vm-modules tests/orchestration-regressions.js",
    "test:watch": "cross-env NODE_ENV=test NODE_OPTIONS=\"--experimental-vm-modules\" jest --watch",
    "test:coverage": "cross-env NODE_ENV=test NODE_OPTIONS=\"--experimental-vm-modules\" jest --coverage",
    "test:help": "node src/index.js --help",
    "server:start": "node src/subtools/server/server.js",
    "server:dev": "node src/subtools/server/server.js --dev",
    "install:all": "npm install && cd src/subtools/service-interface && npm install",
    "model:setup": "npm install && cd src/subtools/service-interface && npm install",
    "model:install": "node src/subtools/service-server/db/init-db.js",
    "model:server": "node src/subtools/service-server/server.js",
    "model:interface": "cd src/subtools/service-interface && npm run dev",
    "model:start": "concurrently \"npm run model:server\" \"npm run model:interface\"",
    "build:ui:static": "cd src/subtools/service-interface && npm run build",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "type-check": "echo 'Type checking skipped for JS project'"
  },
  "keywords": [
    "mux",
    "media",
    "video",
    "subtitle",
    "picture",
    "upload",
    "cli",
    "s3",
    "streaming",
    "analyzer"
  ],
  "author": "KYOOL Media Platform",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.490.0",
    "@aws-sdk/client-sts": "^3.879.0",
    "@aws-sdk/lib-storage": "^3.450.0",
    "@aws-sdk/s3-request-presigner": "^3.490.0",
    "@mux/mux-node": "^12.4.1",
    "@mux/upchunk": "^3.5.0",
    "axios": "^1.11.0",
    "chalk": "^5.3.0",
    "chokidar": "^3.6.0",
    "commander": "^11.1.0",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "fluent-ffmpeg": "^2.1.2",
    "fs-extra": "^11.2.0",
    "glob": "^8.1.0",
    "glob-promise": "^6.0.0",
    "helmet": "^7.1.0",
    "http-proxy-middleware": "^2.0.6",
    "jimp": "^0.22.12",
    "joi": "^17.11.0",
    "jwt-decode": "^4.0.0",
    "lowdb": "^7.0.1",
    "ora": "^7.0.1",
    "pg": "^8.11.3",
    "sharp": "^0.33.5",
    "string-similarity": "^4.0.4",
    "uuid": "^9.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.55.0",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "jest": "^29.7.0",
    "jest-extended": "^4.0.2",
    "nock": "^13.4.0",
    "sinon": "^17.0.1",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kyool-media/uploader-tool"
  }
}
